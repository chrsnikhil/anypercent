#!/bin/sh
# Any%: turn SSH off for a while (judging, an unattended booth) and have it come back by itself.
#   sudo ssh-switch off [MINUTES]    stop SSH; it starts again after MINUTES (default 120), or at the next boot
#   sudo ssh-switch on               start SSH now (and cancel the pending restart)
#   ssh-switch status
# "off" never strands the device: the restart is scheduled before SSH stops, and a reboot brings SSH back too.
set -eu
case "${1:-status}" in
    off)
        mins="${2:-120}"
        systemctl stop anypercent-ssh-back.timer 2>/dev/null || true
        systemd-run --quiet --unit=anypercent-ssh-back --on-active="${mins}m" /bin/systemctl start ssh.service
        systemctl stop ssh.socket 2>/dev/null || true
        systemctl stop ssh.service
        echo "SSH off; back on in ${mins} min (or at the next boot)"
        ;;
    on)
        systemctl stop anypercent-ssh-back.timer 2>/dev/null || true
        systemctl start ssh.service
        echo "SSH on"
        ;;
    status)
        printf 'ssh: %s\n' "$(systemctl is-active ssh.service)"
        systemctl list-timers --no-legend anypercent-ssh-back.timer 2>/dev/null | sed 's/^/back on at: /'
        ;;
    *) echo "usage: ssh-switch off [MINUTES] | on | status" >&2; exit 2 ;;
esac
