# Only the code is tracked. Everything else in this folder (CAD, print files, renders, video, art, music renders,
# ROM builds, device secrets) stays out, even after a careless `git add -A`.

# 1. At the top level: nothing, except these trees.
/*
!/.gitignore
!/README.md
!/launcher/
!/arcade/
!/games/
!/game/
!/apps/
/apps/*
!/apps/world-bridge/
# The Arkiv track's files: its notes and the board snapshot only (never keys or .env values).
!/arkiv/
/arkiv/*
!/arkiv/*.md
!/arkiv/snapshot.json
# The Hedera track's files: its notes only (transaction ids and links; never keys or .env values).
!/hedera/
/hedera/*
!/hedera/*.md

# 2. In the games and the arcade kit: source code and build files only (no art, sound, ROMs or generated frames).
/arcade/**
/games/**
/game/**
!/arcade/**/
!/games/**/
!/game/**/
!/arcade/**/*.c
!/arcade/**/*.h
!/arcade/**/*.py
!/arcade/**/*.sh
!/arcade/**/*.mk
!/arcade/**/*.ini
!/arcade/**/Makefile
!/games/**/*.c
!/games/**/*.h
!/games/**/*.cpp
!/games/**/*.hpp
!/games/**/*.s
!/games/**/*.py
!/games/**/*.sh
!/games/**/*.mk
!/games/**/*.ini
!/games/**/Makefile
!/game/**/*.c
!/game/**/*.h
!/game/**/*.cpp
!/game/**/*.hpp
!/game/**/*.s
!/game/**/*.py
!/game/**/*.sh
!/game/**/*.mk
!/game/**/*.ini
!/game/**/Makefile

# 3. Never, anywhere.
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/build/
**/out/
**/dist/
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.gba
*.gb
*.gbc
*.elf
*.sav
*.o
/games/_kenney/
/games/clips/
/games/reskin/
/games/music/previews/
/launcher/dev/screens/
/apps/world-bridge/data/
