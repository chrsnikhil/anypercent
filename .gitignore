# An allowlist: at the top level only the trees named here are tracked, and the never-list at the end applies inside
# every one of them, even after a careless `git add -A`. Built ROMs and the films are release assets, not files here.

# 1. At the top level: nothing, except these.
/*
!/.gitignore
!/.gitattributes
!/README.md

# The software: the launcher, the arcade kit, the games, the laptop service.
!/launcher/
!/arcade/
!/games/
!/game/
!/apps/
/apps/*
!/apps/world-bridge/

# The sponsor tracks' notes (transaction ids, schemas, the board snapshot; never keys or .env values).
!/arkiv/
/arkiv/*
!/arkiv/*.md
!/arkiv/snapshot.json
!/hedera/
/hedera/*
!/hedera/*.md

# The hardware: CAD, print files, renders, the HTML viewers and their build scripts.
!/cad/
!/cad2/
/cad2/vendor/
/cad2/viewer_cache/
/cad2/logos/**
!/cad2/logos/**/
!/cad2/logos/**/*.py
!/prints/
!/render/
!/assets/
!/Any% *.html
!/viewer.html
!/viewer_template.html
!/stl_viewer.html
!/stl_viewer_template.html
!/build_viewer.ps1
!/build_stl_viewer.ps1

# The device (the Pi's setup, services and tools) and the laptop build sandbox's scripts.
!/device/
!/sandbox/
/sandbox/patches/

# The docs (not the cloned third-party repos or the sponsors' brand kits and saved pages).
!/docs/
/docs/vendor/
/docs/sponsors/

# The films' sources: no renders, review rounds, film copies or third-party fonts (the films are release assets).
!/video/
/video/final/*.mp4
/video/final/rounds/
/video/briefing/public/final/acts/
/video/briefing/public/final/audio/
/video/briefing/public/final/c3d/
/video/briefing/public/final/race/
/video/briefing/public/fonts/
/video/briefing/prep/make_mw3_audio.py

# 2. Games: the clip renderer and the reskins of other people's games keep their scripts only.
/games/clips/**
!/games/clips/**/
!/games/clips/**/*.py
!/games/clips/**/*.c
!/games/clips/**/*.sh
/games/reskin/**
!/games/reskin/**/
!/games/reskin/**/*.py

# 3. Never, anywhere.
**/.superpowers/
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/build/
**/out/
**/dist/
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.p12
*.pfx
*.gba
*.gb
*.gbc
*.elf
*.sav
*.o
/launcher/dev/screens/
/apps/world-bridge/data/
# A recorder log that names the Arkiv RPC with its access key in the URL.
/video/final/rec/live_wallet_book.json
