# An allowlist: at the top level only the trees named here are tracked, and the never-list at the end applies inside
# every one of them, even after a careless `git add -A`. Built ROMs and the films are release assets, not files here.

# 1. At the top level: nothing, except these.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE

# The software: the launcher, the arcade kit, the games, the laptop service.
!/launcher/
!/arcade/
!/games/
!/game/
!/apps/
/apps/*
!/apps/world-bridge/

# The sponsor tracks' notes (transaction ids, schemas, the board snapshot; never keys or .env values).
!/arkiv/
/arkiv/*
!/arkiv/*.md
!/arkiv/snapshot.json

# The hardware: CAD, print files, renders, the HTML viewers and their build scripts.
!/cad/
!/cad2/
/cad2/vendor/
/cad2/viewer_cache/
# Meshes converted from the vendors' own 3D models (Waveshare's 5 inch DSI, Raspberry Pi's Pico R3), which ship
# with no license file: components/build_components.py rebuilds them from the downloads it names.
/cad2/components/display_waveshare_5in_dsi.stl
/cad2/components/pico.stl
/cad2/stl_assembly/asm_display.stl
/cad2/stl_assembly/asm_pico.stl
/cad2/logos/**
!/cad2/logos/**/
!/cad2/logos/**/*.py
!/prints/
!/render/
!/assets/
!/Any% *.html
!/viewer.html
!/viewer_template.html
!/stl_viewer.html
!/stl_viewer_template.html
!/build_viewer.ps1
!/build_stl_viewer.ps1

# The device (the Pi's setup, services and tools) and the laptop build sandbox's scripts.
!/device/
!/sandbox/
/sandbox/patches/

# The films' sources: no renders, review rounds, film copies or third-party fonts (the films are release assets).
!/video/
/video/final/*.mp4
/video/final/rounds/

# 2. Games: ETHGlobal's own logo file stays out (SHIP IT!'s pixel version of it is in its graphics);
# the clip renderer and the reskins of other people's games keep their scripts only.
/games/clips/**
!/games/clips/**/
!/games/clips/**/*.py
!/games/clips/**/*.c
!/games/clips/**/*.sh
/games/reskin/**
!/games/reskin/**/
!/games/reskin/**/*.py
/game/art/source/ethglobal-mumbai-logo.png

# 3. Never, anywhere.
**/.superpowers/
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/build/
**/out/
**/dist/
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.p12
*.pfx
*.gba
*.gb
*.gbc
*.elf
*.sav
*.o
/launcher/dev/screens/
/apps/world-bridge/data/
# A recorder log that names the Arkiv RPC with its access key in the URL.
/video/final/rec/live_wallet_book.json

# 4. Notes stay local: the only markdown here is the README and the Arkiv track's five files.
*.md
!/README.md
!/LICENSE
!/arkiv/*.md
