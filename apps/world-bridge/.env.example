# Any% World bridge. Copy to .env and fill in. Names only here; never commit .env.
# Missing values never stop the bridge: /health reports that part as false.

# ---- IDKit record book (developer.world.org, World ID 4.0 app) ----
WORLD_APP_ID=
WORLD_RP_ID=
# 32-byte hex, shown once by the Developer Portal. Server-side only.
WORLD_SIGNING_KEY=
# The sign-up's uniqueness action. World ID 4.0 spends a human's nullifier on it once, so a
# fresh action means every human can sign up once more (and old books are set aside).
WORLD_ACTION=anypercent-book
# staging = simulator.worldcoin.org, production = the real World App (sandbox also accepted)
WORLD_ENVIRONMENT=staging
# combined (default): the sign-up proof also creates the World ID session approvals prove.
# separate: a second scan (createSession) right after the sign-up; needs a launcher change.
WORLD_SIGNUP_SESSION=

# ---- Listing approvals: which provider runs /agentpass/* ----
# idkit = the book owner proves the World ID session made at sign-up (same app as above)
# agentpass = World IdP device grant (needs the AGENTPASS_* values below)
# Empty: idkit when Agent Pass is not configured and IDKit is, else agentpass.
APPROVALS=

# ---- Agent Pass listing approval (auth.world.org/portal, confidential client) ----
# The issuer; endpoints are discovered from <issuer>/.well-known/openid-configuration
AGENTPASS_ISSUER=https://auth.world.org
AGENTPASS_CLIENT_ID=
# Starts with worldidp_client_secret_ ; shown once by the portal.
AGENTPASS_CLIENT_SECRET=
# Optional: extra accepted acr values, comma-separated (e.g. whatever World's mock proofs return).
AGENTPASS_ACCEPTED_ACR=

# ---- Bridge ----
# Keys every HMAC (book ids, runner ids, stored nullifiers, bound accounts). At least 32 chars.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after the first sign-up: stored books would no longer match their humans.
SERVER_SECRET=
PORT=8787
# 127.0.0.1 = this machine only. See README "Networking" for WSL and the Pi.
HOST=127.0.0.1

# ---- Arkiv (the board; src/arkiv/*). Missing values never stop the bridge: /health says
# arkiv_writes: false and /arkiv/publish answers 503. Service only: none of this goes on the Pi.
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
# Checked against eth_chainId at start and every 30 s; writes stay off if it differs.
ARKIV_CHAIN_ID=7794095
# hub.arkiv.network/access-keys (Rabdi). Sent as the RPC URL's last path segment. Empty = the
# public, rate-limited endpoint.
ARKIV_ACCESS_KEY=
# npm run arkiv:keygen fills these three (it appends, never overwrites, and prints addresses only).
# 0x + 64 hex. Creates every row; never on the Pi, never logged.
ARKIV_CHECKER_KEY=
# A second funded wallet, used only by the look-alike and extension demos.
ARKIV_STRANGER_KEY=
# 64 hex: the HKDF master for listed ghosts. Back it up offline; losing it loses them.
ARKIV_GHOST_SECRET=
ARKIV_SEASON=1
# An ISO 8601 instant (YYYY-MM-DDTHH:MM:SSZ). Season end + 30 d must be under ~180 d from now,
# else writes stay off.
ARKIV_SEASON_END=
# Must equal the launcher's ledger.GHOST_PRICE (cents).
ARKIV_GHOST_PRICE_C=10
# /arkiv/ghost accepts the launcher mock's receipts (mock-<8 hex>) until Hedera is real.
ARKIV_MOCK_PAYMENTS=1
# The replay tools, one per arcade id ({game}). On Windows they are the WSL sandbox's Linux builds:
CHECKER_REPLAY=/opt/arca-sandbox/games/arcade/{game}/arcade_replay
# Run the tool via `wsl.exe -d <distro> -e`, with C:\ paths mapped to /mnt/c/. Empty on Linux.
CHECKER_WSL=Ubuntu-24.04

# ---- Hedera (src/hedera/*): PB pays over x402, receipts on HCS. Testnet only. Missing values never
# stop the bridge: /health says hedera_pay / hedera_record: false and the routes answer 503. Every
# key stays in this service: none of this goes on the Pi.
HEDERA_NETWORK=testnet
HEDERA_MIRROR=https://testnet.mirrornode.hedera.com
# Your portal.hedera.com testnet account (ECDSA). Pays HCS fees and funds the agent; its key is the
# market topic's submit key. The key as the portal shows it, DER (starts with 30...). Never logged.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# npm run hedera:setup fills these three (it appends, never overwrites): PB's wallet (the x402
# client) and the market topic (created with no admin key).
HEDERA_AGENT_ID=
HEDERA_AGENT_KEY=
HEDERA_TOPIC_ID=
# Testnet USDC (6 decimals); checked against the mirror's token info at start. Never 0.0.5449.
HEDERA_USDC=0.0.429274
# The x402 facilitators: the first whose /supported answers names the fee payer in new 402s.
X402_FACILITATOR=https://x402.org/facilitator
X402_FACILITATOR_FALLBACK=https://api.testnet.blocky402.com
# Optional pin, comma-separated 0.0.N: the only fee payers the agent accepts.
X402_FEE_PAYERS=
# Where the agent reaches /x402/*. Empty: http://<HOST, 0.0.0.0 -> 127.0.0.1>:<PORT>.
HEDERA_RESOURCE_BASE=
# PB's caps, in cents: per purchase, per buyer book per day (the launcher's DAILY_BUDGET), per day
# across all books.
HEDERA_MAX_PRICE_C=10
HEDERA_BOOK_DAY_C=100
HEDERA_AGENT_DAY_C=500
# The Live-run stretch only (not built).
HEDERA_LIVE_TOPIC_ID=
# With Hedera payments configured, /arkiv/ghost takes only receipts the paywall settled and ignores
# ARKIV_MOCK_PAYMENTS; set it to 0 then.

# ---- Scout and pivot: consoles, lap splits, PB's scout on Groq, the house's BOT batches ----
# console.groq.com API key. Service only, never logged or sent anywhere but Groq. Empty: the scout
# runs the board's rule ("the ghost just ahead") and /health says scout: rule.
GROQ_API_KEY=
# Pinned: a production model with strict structured outputs.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=6000
# Printable ASCII characters of the model's reason (two lines on the pick card, and INTENT).
SCOUT_REASON_MAX=110
# The lap-splits tool, one per arcade id ({game}). Empty: arcade_splits beside CHECKER_REPLAY.
CHECKER_SPLITS=/opt/arca-sandbox/games/arcade/{game}/arcade_splits
SPLIT_GAMES=MDGP
# The Arkiv explorer's link templates (every explorer URL the bridge answers).
ARKIV_EXPLORER_TX=https://rabdi.explorer.arkiv.network/tx/{tx}
ARKIV_EXPLORER_ENTITY=https://rabdi.explorer.arkiv.network/entity/{key}
# npm run hedera:setup -- --house fills these two (it appends, never overwrites). The service never
# signs with the house key; it is there so the owner can move the house's testnet USDC. Back it up offline.
HEDERA_HOUSE_ID=
HEDERA_HOUSE_KEY=
# The only record book whose World approval publishes a house batch (hedera:setup -- --house --owner ANY-XXX).
HOUSE_OWNER_BOOK=
HOUSE_MAX_BATCH=8
HOUSE_TX_PAIRS=6
