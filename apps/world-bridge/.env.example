# Any% World bridge. Copy to .env and fill in. Names only here; never commit .env.
# Missing values never stop the bridge: /health reports that part as false.

# ---- IDKit record book (developer.world.org, World ID 4.0 app) ----
WORLD_APP_ID=
WORLD_RP_ID=
# 32-byte hex, shown once by the Developer Portal. Server-side only.
WORLD_SIGNING_KEY=
# The sign-up's uniqueness action. World ID 4.0 spends a human's nullifier on it once, so a
# fresh action means every human can sign up once more (and old books are set aside).
WORLD_ACTION=anypercent-book
# staging = simulator.worldcoin.org, production = the real World App (sandbox also accepted)
WORLD_ENVIRONMENT=staging
# combined (default): the sign-up proof also creates the World ID session approvals prove.
# separate: a second scan (createSession) right after the sign-up; needs a launcher change.
WORLD_SIGNUP_SESSION=

# ---- Listing approvals: which provider runs /agentpass/* ----
# idkit = the book owner proves the World ID session made at sign-up (same app as above)
# agentpass = World IdP device grant (needs the AGENTPASS_* values below)
# Empty: idkit when Agent Pass is not configured and IDKit is, else agentpass.
APPROVALS=

# ---- Agent Pass listing approval (auth.world.org/portal, confidential client) ----
# The issuer; endpoints are discovered from <issuer>/.well-known/openid-configuration
AGENTPASS_ISSUER=https://auth.world.org
AGENTPASS_CLIENT_ID=
# Starts with worldidp_client_secret_ ; shown once by the portal.
AGENTPASS_CLIENT_SECRET=
# Optional: extra accepted acr values, comma-separated (e.g. whatever World's mock proofs return).
AGENTPASS_ACCEPTED_ACR=

# ---- Bridge ----
# Keys every HMAC (book ids, runner ids, stored nullifiers, bound accounts). At least 32 chars.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after the first sign-up: stored books would no longer match their humans.
SERVER_SECRET=
PORT=8787
# 127.0.0.1 = this machine only. See README "Networking" for WSL and the Pi.
HOST=127.0.0.1
