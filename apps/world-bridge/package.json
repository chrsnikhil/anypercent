{
  "name": "world-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Any% World bridge: IDKit record book + listing approvals, the Arkiv board (checked run rows, listings, the web board), and Hedera (PB pays over x402, receipts on HCS).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "arkiv:keygen": "tsx scripts/arkiv-keygen.ts",
    "arkiv:smoke": "tsx scripts/arkiv-smoke.ts",
    "arkiv:open-run": "tsx scripts/arkiv-open-run.ts",
    "arkiv:lookalike": "tsx scripts/arkiv-lookalike.ts",
    "arkiv:extend": "tsx scripts/arkiv-extend.ts",
    "arkiv:snapshot": "tsx scripts/arkiv-snapshot.ts",
    "hedera:setup": "tsx scripts/hedera-setup.ts",
    "hedera:payto": "tsx scripts/hedera-payto.ts",
    "hedera:smoke": "tsx scripts/hedera-smoke.ts",
    "hedera:agent": "tsx scripts/hedera-agent.ts",
    "hedera:evil402": "tsx scripts/hedera-evil402.ts",
    "hedera:verify": "tsx scripts/hedera-verify.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hiero-ledger/sdk": "2.90.1",
    "@worldcoin/idkit-core": "4.6.0",
    "@x402/core": "2.30.0",
    "@x402/hedera": "2.30.0",
    "jose": "6.2.15",
    "oauth4webapi": "3.8.8",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
