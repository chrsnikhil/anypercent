{
  "name": "world-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Any% World bridge: IDKit record book + listing approvals and console binding, the Arkiv board (console-owned runs and listings the checker stamps, lap splits, BOT batches from the house wallet, the web board), Hedera (PB pays over x402, receipts on HCS) and PB's scout on Groq.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "arkiv:keygen": "tsx scripts/arkiv-keygen.ts",
    "arkiv:smoke": "tsx scripts/arkiv-smoke.ts",
    "arkiv:lookalike": "tsx scripts/arkiv-lookalike.ts",
    "arkiv:extend": "tsx scripts/arkiv-extend.ts",
    "arkiv:snapshot": "tsx scripts/arkiv-snapshot.ts",
    "arkiv:fund": "tsx scripts/arkiv-fund.ts",
    "hedera:setup": "tsx scripts/hedera-setup.ts",
    "hedera:payto": "tsx scripts/hedera-payto.ts",
    "hedera:smoke": "tsx scripts/hedera-smoke.ts",
    "hedera:agent": "tsx scripts/hedera-agent.ts",
    "hedera:evil402": "tsx scripts/hedera-evil402.ts",
    "hedera:verify": "tsx scripts/hedera-verify.ts",
    "console:link": "tsx scripts/console-op.ts link",
    "console:release": "tsx scripts/console-op.ts release",
    "house:publish": "tsx scripts/house-publish.ts",
    "scout:smoke": "tsx scripts/scout-smoke.ts",
    "arkiv:tamper": "tsx scripts/arkiv-tamper.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@hiero-ledger/sdk": "2.90.1",
    "@worldcoin/idkit-core": "4.6.0",
    "@x402/core": "2.30.0",
    "@x402/hedera": "2.30.0",
    "jose": "6.2.15",
    "oauth4webapi": "3.8.8",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/qrcode": "1.5.6",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
